{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "platform": "github",
  "onboarding": false,
  "requireConfig": "optional",
  "forkProcessing": "enabled",
  "globalExtends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "semanticCommits": "enabled",
  "dependencyDashboard": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "automerge": false,
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security",
      "dependencies"
    ]
  },
  "repositories": [
    {
      "repository": "westcoder/ack-desk",
      "baseBranchPatterns": [
        "develop"
      ]
    }
  ],
  "enabledManagers": [
    "poetry",
    "pep621",
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "circleci"
  ],
  "packageRules": [
    {
      "description": "Group all non-major updates (including monorepos) into a single nightly PR and automerge after green CI",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true,
      "platformAutomerge": false,
      "ignoreTests": false,
      "prPriority": 10,
      "prConcurrentLimit": 10,
      "branchConcurrentLimit": 10,
      "prHourlyLimit": 0
    },
    {
      "description": "Throttle major updates to max 2 concurrent PRs/branches and max 1 new major PR alongside non-major without automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "rebaseWhen": "conflicted",
      "prPriority": -5,
      "prConcurrentLimit": 2,
      "branchConcurrentLimit": 2,
      "prHourlyLimit": 2,
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ]
}
