# Vorlage für /opt/patchbot/deploy/.env (chmod 0600, nicht committen).
# Beschreibung aller Variablen: docs/runbooks/patchbot-v2-rollout.md, Abschnitt "Umgebungsvariablen".

# --- Django / Datenbank (Pflicht) ---
DJANGO_SECRET_KEY=change-me-to-at-least-32-random-characters-0000
DJANGO_ALLOWED_HOSTS=patch.westcode.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://patch.westcode.de
POSTGRES_PASSWORD=change-me
PATCHBOT_BASE_URL=https://patch.westcode.de

# --- Microsoft Entra ID (Pflicht) ---
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=change-me
MICROSOFT_REDIRECT_URI=https://patch.westcode.de/api/auth/entra/callback/

# --- Öffentliche Webhooks (Pflicht) ---
SLACK_SIGNING_SECRET=change-me
GITHUB_WEBHOOK_SECRET=change-me

# --- Slack Web API (optional; ohne Token keine DMs/Posts) ---
SLACK_BOT_TOKEN=
SLACK_TEAM_CHANNEL_ID=

# --- GitHub App (Pflicht; Private Key liegt in deploy/secrets/github-app.pem) ---
GITHUB_APP_ID=000000
GITHUB_APP_INSTALLATION_ID=00000000

# --- Claude (optional; ohne Key bleiben Findings UNTRIAGED) ---
ANTHROPIC_API_KEY=
PATCHBOT_CLAUDE_MODEL=claude-sonnet-5-5
PATCHBOT_CLAUDE_EFFORT=
PATCHBOT_CLAUDE_REFUSAL_FALLBACK=true

# --- Notion (optional; ohne Key wird der Sync übersprungen) ---
NOTION_API_KEY=
NOTION_PROJECTS_DATABASE_ID=41931ab45ea846acbfe46b3305898af2

# --- Fristen ---
PATCHBOT_HOLIDAY_SUBDIVISION=NW
PATCHBOT_EXTRA_HOLIDAYS=

# --- AWS / ECR ---
AWS_REGION=eu-central-1

# --- Nur mit compose.ai-patching.yaml: Gruppen-ID von /var/run/docker.sock (stat -c %g /var/run/docker.sock) ---
DOCKER_GID=
