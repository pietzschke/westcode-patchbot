# Code-patching sandbox for Python projects (spec §5.5), tag: patchbot-sandbox:python312
#   docker build -t patchbot-sandbox:python312 -f deploy/sandbox/Dockerfile.python312 deploy/sandbox
#
# research.sandbox starts it with --read-only, --cap-drop=ALL, no-new-privileges, --user=1000:1000,
# a tmpfs on /tmp and only the worktree mounted at /work. The image holds no credentials; the only
# way out is the allow-listing egress proxy on the internal network patchbot-sandbox-egress.
FROM ghcr.io/astral-sh/uv:0.11.11 AS uv

FROM python:3.12-slim-trixie

# uv backs the allow-listed dependency installs (`uv sync --frozen --no-build --no-install-workspace`,
# `uv pip install --no-build -r requirements*.txt`); pytest backs `python -m pytest -q`.
COPY --from=uv /uv /usr/local/bin/uv
RUN python -m pip install --no-cache-dir --disable-pip-version-check "pytest==8.4.2" \
    && groupadd --gid 1000 sandbox \
    && useradd --uid 1000 --gid 1000 --home-dir /tmp --no-create-home --shell /usr/sbin/nologin sandbox \
    && printf '%s\n' '#!/bin/sh' 'set -eu' \
        '# /tmp is a fresh tmpfs per container: create the venv the allow-listed installs target.' \
        '# --system-site-packages keeps the pytest of the image importable from it.' \
        'uv venv --quiet --system-site-packages "$VIRTUAL_ENV"' \
        'exec "$@"' > /usr/local/bin/sandbox-entrypoint \
    && chmod 0755 /usr/local/bin/sandbox-entrypoint

# Root filesystem is read-only at runtime: everything writable lives under /tmp. The venv must never
# live in the mounted worktree (/work), or it would end up in the diff.
ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INPUT=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/tmp/.pip \
    VIRTUAL_ENV=/tmp/venv \
    UV_PROJECT_ENVIRONMENT=/tmp/venv \
    UV_CACHE_DIR=/tmp/.uv-cache \
    UV_PYTHON=/usr/local/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1 \
    PATH=/tmp/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    HTTP_PROXY=http://egress-proxy:3128 \
    HTTPS_PROXY=http://egress-proxy:3128 \
    http_proxy=http://egress-proxy:3128 \
    https_proxy=http://egress-proxy:3128 \
    NO_PROXY=localhost,127.0.0.1 \
    no_proxy=localhost,127.0.0.1

WORKDIR /work
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/sandbox-entrypoint"]
CMD ["sleep", "infinity"]
