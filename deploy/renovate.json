{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "platform": "github",
  "onboarding": false,
  "requireConfig": "optional",
  "includeForks": true,
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "automerge": false,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security",
      "dependencies"
    ]
  },
  "repositories": [
    {
      "repository": "westcoder/ack-desk",
      "baseBranchPatterns": [
        "develop"
      ]
    }
  ],
  "enabledManagers": [
    "poetry",
    "pep621",
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "circleci"
  ],
  "packageRules": [
    {
      "description": "Group non-major updates into a single nightly PR and automerge after green CI",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true,
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "description": "Isolate major updates into dedicated PRs without automerge or noisy rebasing",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "automerge": false,
      "rebaseWhen": "conflicted",
      "labels": [
        "dependencies",
        "major-update"
      ]
    }
  ]
}
